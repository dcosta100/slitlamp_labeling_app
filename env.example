# ============================================================
# Slitlamp Labeling App - Environment Configuration
# ============================================================
# IMPORTANT: Fill in ALL paths below with your machine's paths
# DO NOT leave paths empty - the app will fail to start!
# 
# To use this file:
#   1. Copy this file: cp .env.example .env
#   2. Fill in YOUR paths below (replace the examples)
#   3. Save the file
#   4. Run: python check_paths.py (to verify)
#   5. Run: streamlit run app.py
# ============================================================

# ── REQUIRED: Data File Paths ───────────────────────────────
# Replace these with YOUR actual file locations

# Path to diagnosis .dta file
DIAGNOSIS_PATH=C:/Users/YourUser/data/studyinfo_laterality_diagnosis.dta

# Path to crosswalk CSV
CROSS_PATH=C:/Users/YourUser/data/slitlamp_crosswalk_complete_12082025.csv

# Path to annotations CSV
ANNOTATIONS_PATH=C:/Users/YourUser/data/BPGR_slexam_all.csv

# Path to anonymized EHR notes (parquet file)
ANONYMIZED_EHR_PATH=C:/Projects/slitlamp_labeling_app/preprocessing/ehr_anonymized_all.parquet

# ── REQUIRED: Image Storage Path ────────────────────────────
# This is the base folder containing all maskedid subfolders
# Usually on network drive L:\ or external drive

IMAGE_BASE_PATH=L:/SlitLamp

# ── REQUIRED: Preprocessed Dataset ──────────────────────────
# HIGHLY RECOMMENDED: Set to True for 10x faster loading

USE_PREPROCESSED=True

# Path to preprocessed parquet file
# Can be relative (from project root) or absolute
PREPROCESSED_PATH=data/preprocessed_dataset.parquet

# ── OPTIONAL: Dataset Filtering ─────────────────────────────
# What images to show by default
# Options: ALL, NOTES, ANNOTATIONS, NOTES_AND_ANNOTATIONS, WITH_AI_PRELABEL

DEFAULT_DATASET_FILTER=WITH_AI_PRELABEL

# ── NOTES ────────────────────────────────────────────────────
# Windows paths can use forward slashes: C:/path/to/file
# Or backslashes (escaped): C:\\path\\to\\file
# 
# After editing:
#   1. Save this file as .env (remove .example)
#   2. Run: python check_paths.py
#   3. Fix any ❌ errors shown
#   4. When all ✅ green: streamlit run app.py
# ============================================================
