# ============================================================
# Slitlamp Labeling App - Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in the paths for THIS machine.
#
#   copy .env.example .env
#
# The five REQUIRED paths below have no defaults: if any of them is
# missing or empty the application refuses to start and tells you which
# one. Everything under OPTIONAL already has a sensible default.
#
# Windows paths may use forward slashes (C:/path/to/file) or escaped
# backslashes (C:\\path\\to\\file).
# ============================================================

# ── REQUIRED: source data ───────────────────────────────────

# Diagnosis / laterality per study (Stata .dta)
DIAGNOSIS_PATH=C:/Users/YourUser/data/studyinfo_laterality_diagnosis.dta

# Anonymized EHR progress notes (parquet).
# NOTE: the variable is NOTES_PATH, not ANONYMIZED_EHR_PATH.
NOTES_PATH=C:/Projects_Local/slitlamp_labeling_app/preprocessing/ehr_anonymized_all.parquet

# Image inventory / crosswalk (CSV)
CROSS_PATH=C:/Users/YourUser/data/slitlamp_crosswalk_complete_12082025.csv

# Structured slit lamp exam annotations (CSV)
ANNOTATIONS_PATH=C:/Users/YourUser/data/BPGR_slexam_all.csv

# ── REQUIRED: image storage ─────────────────────────────────
# Base folder holding the maskedid subfolders. Images are looked up as
#   IMAGE_BASE_PATH/maskedid/maskedid_studyid/proc_name/photo_name
IMAGE_BASE_PATH=L:/SlitLamp

# ── OPTIONAL: preprocessed dataset ──────────────────────────
# Strongly recommended. Build it once with
#   python preprocessing/create_preprocessed_dataset.py
USE_PREPROCESSED=True
PREPROCESSED_PATH=C:/Projects_Local/slitlamp_labeling_app/data/preprocessed_dataset.parquet

# ── OPTIONAL: dataset filtering ─────────────────────────────
# Which images enter the labeling routes.
# ALL | NOTES | ANNOTATIONS | NOTES_AND_ANNOTATIONS | WITH_AI_PRELABEL
DEFAULT_DATASET_FILTER=WITH_AI_PRELABEL

# ── OPTIONAL: matching windows ──────────────────────────────
# How far from the exam date a note / annotation may be, in days.
MAX_NOTE_DAYS_DIFFERENCE=365
MAX_ANNOTATION_DAYS_DIFFERENCE=7

# Prefill the form from another image of the same study.
ENABLE_AUTOFILL_SAME_STUDYID=True

# ── OPTIONAL: session activity logging ──────────────────────
# How often an open session writes a heartbeat (seconds). Every save is
# logged regardless of this interval.
HEARTBEAT_INTERVAL_SECONDS=60

# Gap above which the labeler counts as away, so idle browser tabs do
# not inflate their working hours (minutes).
SESSION_IDLE_TIMEOUT_MINUTES=15

# ── OPTIONAL: default admin account ─────────────────────────
# Only used the first time, when data/users/users.json is created.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
